<html lang="en">
<%- include('layouts/header'); -%>
   <body onload="init();">
   <%- include('layouts/heading'); -%>
   <%- include('layouts/navbar'); -%>
      <div class="main">
         <textarea style="display:none;" id="currentVersions" ><%= typeof currentVersions !== 'undefined' ? JSON.stringify(currentVersions):'' %></textarea> 
         <textarea style="display:none;" id="classification" ><%= typeof classification !== 'undefined' ? JSON.stringify(classification):'' %></textarea>          
         <h1>Toxicity Test</h1>
         <h6>Test the toxiticy of a text</h6><br>
         <hr>
         Please enter the text you want to test for toxicity:<br><p><br></p>         
         <form id="toxicityForm" action="/toxicitytest" method="post" enctype="multipart/form-data">
            <p><label>Text to test:</label>
            <textarea id="testString" name="testString" class="textareaBlock"></textarea><p ><br class="zbr">
            <button type="submit">Test</button>
         </form>         
      </div>   
      <div class="versions">
         <div id="versionItems"></div>         
      </div>    
      <script src="/js/versionInformation.js"></script>
      <script src='/js/toxicitytest.js'> </script>
   </body>
</html>